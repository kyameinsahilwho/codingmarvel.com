---
import "../styles/global.css";

const seo = {
  title: "CodingMarvel | Web Tools Directory",
  description: "codingmarvel.com - a simple directory of my other websites.",
  canonical: "https://codingmarvel.com/",
  ogImage: "https://codingmarvel.com/og.svg",
  ogImageAlt: "CodingMarvel - Web Tools Directory",
  keywords:
    "codingmarvel, web tools, online utilities, pdf merge, clipboard manager",
  author: "CodingMarvel",
  locale: "en_US",
  type: "website",
  themeColor: "#0f1020",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CodingMarvel",
  url: seo.canonical,
  description: seo.description,
  inLanguage: "en",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://codingmarvel.com/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const websites = [
  {
    name: "Pdf Merge Tool",
    url: "https://pdf.codingmarvel.com",
    description: "A simple tool to merge multiple PDF files into one.",
  },
  {
    name: "Clipboard",
    url: "https://clipboard.codingmarvel.com",
    description: "Manage, organise and share your copy pastes with ease.",
  },
  {
    name: "Video Grid Maker",
    url: "https://video-grid-maker.codingmarvel.com/",
    description: "This website makes grid image map out of a video.",
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Bungee&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:site_name" content="CodingMarvel" />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  </head>
  <body>
    <div class="bg-orbs" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="gaming-elements" aria-hidden="true">
      <span class="game-el game-el--1">▲</span>
      <span class="game-el game-el--2">◆</span>
      <span class="game-el game-el--3">●</span>
      <span class="game-el game-el--4">■</span>
      <span class="game-el game-el--5">✕</span>
      <span class="game-el game-el--6">★</span>
      <span class="game-el game-el--7">◆</span>
      <span class="game-el game-el--8">●</span>
    </div>
    <main class="page">
      <header class="header">
        <h1 class="brand">CODINGMARVEL.COM</h1>
        <p class="subtitle">
          New here? Welcome! Discover a great collection of web tools — pick any
          square below to jump in.
        </p>
      </header>

      <ul class="list">
        {websites.map((site) => (
          <li>
            <a class="card" href={site.url} target="_blank" rel="noreferrer">
              <div class="card-title">{site.name}</div>
              <p class="card-desc">{site.description}</p>
              <span class="card-link">Visit {site.name}</span>
              <span class="card-arrow" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <footer class="footer">
        © {new Date().getFullYear()} codingmarvel.com · Built for quick discovery of useful web tools.
      </footer>
    </main>
  </body>
</html>
