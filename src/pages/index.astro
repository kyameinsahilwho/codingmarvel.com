---
import "../styles/global.css";
import { apps, type App } from "../data/apps";
import AppActions from "../components/AppActions.astro";
import EnamelShader from "../components/EnamelShader.astro";
import KeyShader from "../components/KeyShader.astro";
import { keyColor } from "../lib/keyColor";

const byPlatform = (p: App["platform"]) => apps.filter((a) => a.platform === p);

const seo = {
  title: "CodingMarvel | Web Tools, Windows Apps, Extensions & Skills",
  description:
    "codingmarvel.com is a directory of tools by CodingMarvel: browser apps for tasks, habits, PDFs and video, native Windows utilities built in Rust, Chrome extensions and Claude Code agent skills.",
  canonical: "https://codingmarvel.com/",
  ogImage: "https://codingmarvel.com/og.svg",
  ogImageAlt: "CodingMarvel - Web Tools Directory",
  keywords: [
    "codingmarvel",
    "web tools",
    "online utilities",
    "rust windows apps",
    "tauri",
    ...apps.flatMap((a) => [a.plainName ?? a.name, ...a.keywords]),
  ].join(", "),
  author: "CodingMarvel",
  locale: "en_US",
  type: "website",
  themeColor: "#e53935",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "CodingMarvel",
      url: seo.canonical,
      description: seo.description,
      inLanguage: "en",
    },
    {
      "@type": "ItemList",
      name: "CodingMarvel apps",
      // Only apps people can actually reach (a site or a public repo).
      itemListElement: apps
        .filter((a) => primaryUrl(a))
        .map((a, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "SoftwareApplication",
            name: a.plainName ?? a.name,
            description: a.description,
            url: primaryUrl(a),
            applicationCategory: a.category,
            operatingSystem: osFor(a.platform),
            ...(sourceUrl(a) ? { codeRepository: sourceUrl(a) } : {}),
            ...(a.download ? { downloadUrl: a.download } : {}),
            offers: {
              "@type": "Offer",
              price: a.price?.amount ?? "0",
              priceCurrency: a.price?.currency ?? "USD",
            },
          },
        })),
    },
  ],
};

function sourceUrl(a: App) {
  return a.sourceUrl ?? (a.repo ? `https://github.com/${a.repo}` : null);
}

function primaryUrl(a: App) {
  return a.url ?? sourceUrl(a);
}

function osFor(p: App["platform"]) {
  return { Web: "Any (web browser)", Windows: "Windows 10, Windows 11", Chrome: "Google Chrome", Skill: "Claude Code" }[p];
}

const sections = [
  {
    id: "web",
    title: "Web apps",
    note: "Run in your browser. Nothing to install.",
    items: byPlatform("Web"),
  },
  {
    id: "windows",
    title: "Windows apps",
    note: "Native desktop tools in Rust. Free installers on GitHub.",
    items: byPlatform("Windows"),
  },
  {
    id: "extensions",
    title: "Chrome extensions",
    note: "Free. Install from GitHub with Load unpacked.",
    items: byPlatform("Chrome"),
  },
  {
    id: "skills",
    title: "Agent skills",
    note: "Claude Code skills I use and share.",
    items: byPlatform("Skill"),
  },
];

const icons = {
  chevron: '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Bungee&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:site_name" content="CodingMarvel" />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <noscript>
      <style>
        /* specific enough to beat global.css, which loads after this */
        .app .app-details { grid-template-rows: 1fr; }
        .app .app-details-inner { visibility: visible; }
        .app .app-details-body { opacity: 1; transform: none; }
        .app .app-chevron { display: none; }
      </style>
    </noscript>
  </head>
  <body>
    <main class="page">
      <div class="halftone" aria-hidden="true"></div>
      <header class="header">
        <EnamelShader />
        <h1 class="brand">CODINGMARVEL.COM</h1>
        <p class="subtitle" data-enamel-text>
          Tools I build and use every day. Pick an app to see what it does, then open it.
        </p>
        <nav class="header-meta" aria-label="Sections" data-enamel-text>
          {sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title}
              <span aria-hidden="true">{s.items.length}</span>
            </a>
          ))}
        </nav>
      </header>

      <div class="sections">
        {/* Two stacks of two: four columns on desktop (the stacks dissolve),
            two independent columns on tablet, one on phones. */}
        {[sections.slice(0, 2), sections.slice(2)].map((stack) => (
          <div class="stack">
        {stack.map((section) => (
          <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="section-head">
              <h2 class="section-title" id={`${section.id}-title`}>
                {section.title}
                <span class="section-count" aria-hidden="true">{section.items.length}</span>
                <span class="sr-only">({section.items.length})</span>
              </h2>
              <p class="section-note">{section.note}</p>
            </div>

            <ul class="list">
              {section.items.map((app) => {
                const detailsId = `app-${app.slug}-details`;
                const label = app.plainName ?? app.name;
                return (
                  <li class="app" style={`--accent: ${app.accent}; --key: ${keyColor(app.accent)}`} data-app>
                    <h3 class="app-title">
                      <button class="app-head" type="button" aria-expanded="false" aria-controls={detailsId} data-toggle>
                        <span class={`app-icon${app.iconFull ? " is-full" : ""}`} aria-hidden="true">
                          <img src={app.icon} alt="" width="48" height="48" loading="lazy" decoding="async" />
                        </span>
                        <span class="app-heading">
                          <span class="app-name">
                            <span aria-hidden={app.plainName ? "true" : undefined}>{app.name}</span>
                            {app.plainName && <span class="sr-only">{app.plainName}</span>}
                          </span>
                          <span class="app-tagline">{app.tagline}</span>
                        </span>
                        <span class="app-chevron" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron} />
                        </span>
                      </button>
                    </h3>

                    <div class="app-details" id={detailsId}>
                      <div class="app-details-inner">
                        <div class="app-details-body">
                          <p class="app-desc">{app.description}</p>
                          <ul class="app-features" aria-label={`${label} features`}>
                            {app.features.map((f) => (
                              <li>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
                                <span>{f}</span>
                              </li>
                            ))}
                          </ul>
                          {app.price && <p class="app-note">{app.price.note}</p>}
                          {app.note && <p class="app-note">{app.note}</p>}
                          {app.credit && <p class="app-note">{app.credit}</p>}
                          <ul class="app-stack" aria-label="Built with">
                            {app.stack.map((s) => <li>{s}</li>)}
                          </ul>
                          <AppActions app={app} label={label} />
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
          </div>
        ))}
      </div>

      <footer class="footer">
        © {new Date().getFullYear()} codingmarvel.com · More projects on
        <a href="https://github.com/kyameinsahilwho" target="_blank" rel="noopener">GitHub</a>.
      </footer>
    </main>

    <KeyShader />

    <script>
      // Accordion: each card opens in place and pushes the cards below it
      // down. Any number can be open at once.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      document.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>("[data-app]");
          if (!card) return;
          const open = card.classList.toggle("is-open");
          btn.setAttribute("aria-expanded", String(open));
          if (!open) return;
          // Once it has grown, bring a card that opened past the fold into view.
          const panel = card.querySelector<HTMLElement>(".app-details");
          const reveal = () => {
            if (!card.classList.contains("is-open")) return;
            const r = card.getBoundingClientRect();
            const room = window.innerHeight - 16;
            if (r.bottom > room) {
              const by = Math.min(r.bottom - room, r.top - 16);
              if (by > 0) window.scrollBy({ top: by, behavior: reduceMotion.matches ? "auto" : "smooth" });
            }
          };
          if (!panel) return reveal();
          // Wait for the panel to finish growing (also under reduced motion,
          // where it still runs a 1 ms transition); a timer covers browsers
          // that do not animate grid rows and so never fire transitionend.
          let fired = false;
          const go = () => {
            if (fired) return;
            fired = true;
            panel.removeEventListener("transitionend", done);
            reveal();
          };
          const timer = setTimeout(go, reduceMotion.matches ? 60 : 520);
          const done = (e: TransitionEvent) => {
            if (e.target !== panel || e.propertyName !== "grid-template-rows") return;
            clearTimeout(timer);
            go();
          };
          panel.addEventListener("transitionend", done);
        });
      });

      // Pointer spotlight on the card heads (a CSS radial glow that tracks the cursor).
      document.querySelectorAll<HTMLElement>(".app-head").forEach((head) => {
        head.addEventListener(
          "pointermove",
          (e) => {
            if (e.pointerType === "touch") return;
            const r = head.getBoundingClientRect();
            head.style.setProperty("--mx", `${e.clientX - r.left}px`);
            head.style.setProperty("--my", `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      });
    </script>
  </body>
</html>
