---
import "../styles/global.css";

const seo = {
  title: "CodingMarvel | Web Tools Directory",
  description: "codingmarvel.com - a simple directory of my other websites.",
  canonical: "https://codingmarvel.com/",
  ogImage: "https://codingmarvel.com/og.svg",
  ogImageAlt: "CodingMarvel - Web Tools Directory",
  keywords:
    "codingmarvel, web tools, online utilities, eisenhower matrix, task manager, habit tracker, habit sheets, video thumbnail grid, video contact sheet, pdf fusion, pdf merge, pdf utilities, x-tracker",
  author: "CodingMarvel",
  locale: "en_US",
  type: "website",
  themeColor: "#0f1020",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CodingMarvel",
  url: seo.canonical,
  description: seo.description,
  inLanguage: "en",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://codingmarvel.com/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const websites = [
  {
    name: "Ehmatrix",
    url: "https://ehmatrix.codingmarvel.com",
    description: "An intuitive task management app based on the Eisenhower matrix, with seamless drag-and-drop support, theme selection, and confetti feedback.",
    accent: "#0284c7",
    bg: "linear-gradient(135deg, rgba(2, 132, 199, 0.09) 0%, rgba(2, 132, 199, 0.02) 100%)",
    border: "rgba(2, 132, 199, 0.22)",
    hoverBorder: "rgba(2, 132, 199, 0.5)",
    iconBg: "rgba(2, 132, 199, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><line x1="12" y1="3" x2="12" y2="21"></line><line x1="3" y1="12" x2="21" y2="12"></line><polyline points="7 7 8.5 8.5 10.5 5.5"></polyline></svg>`,
  },
  {
    name: "HabitGrid",
    url: "https://habitgrid.codingmarvel.com",
    description: "Create beautiful, customizable, and print-ready habit sheets to easily track your daily routines and personal habits.",
    accent: "#059669",
    bg: "linear-gradient(135deg, rgba(5, 150, 105, 0.09) 0%, rgba(5, 150, 105, 0.02) 100%)",
    border: "rgba(5, 150, 105, 0.22)",
    hoverBorder: "rgba(5, 150, 105, 0.5)",
    iconBg: "rgba(5, 150, 105, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M9 16l2 2 4-4"></path></svg>`,
  },
  {
    name: "Video Grid Maker",
    url: "https://video-grid-maker.codingmarvel.com",
    description: "The ultimate tool to create professional video thumbnail grids. Extract frames with precise intervals, add timestamps, and export high-quality contact sheets instantly.",
    accent: "#7c3aed",
    bg: "linear-gradient(135deg, rgba(124, 58, 237, 0.09) 0%, rgba(124, 58, 237, 0.02) 100%)",
    border: "rgba(124, 58, 237, 0.22)",
    hoverBorder: "rgba(124, 58, 237, 0.5)",
    iconBg: "rgba(124, 58, 237, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>`,
  },
  {
    name: "Love for PDF",
    url: "https://pdf.codingmarvel.com/",
    description: "100% Free, Private & Secure PDF Tools running entirely in your web browser. Edit, merge, split, compress, convert, redact & sign PDFs.",
    accent: "#e11d48",
    bg: "linear-gradient(135deg, rgba(225, 29, 72, 0.09) 0%, rgba(225, 29, 72, 0.02) 100%)",
    border: "rgba(225, 29, 72, 0.22)",
    hoverBorder: "rgba(225, 29, 72, 0.5)",
    iconBg: "rgba(225, 29, 72, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M12 18s-3-2.1-3-4a2 2 0 0 1 3.4-1.4A2 2 0 0 1 15 14c0 1.9-3 4-3 4z" fill="currentColor" fill-opacity="0.25"></path></svg>`,
  },
  {
    name: "Young Again",
    url: "https://youngagain.codingmarvel.com/",
    description: "Curated 18+ artistic gallery of 4K anime softcore, realistic boudoir, lingerie, bedroom, seductive neo-noir, and landscape mood photography.",
    accent: "#db2777",
    bg: "linear-gradient(135deg, rgba(219, 39, 119, 0.09) 0%, rgba(219, 39, 119, 0.02) 100%)",
    border: "rgba(219, 39, 119, 0.22)",
    hoverBorder: "rgba(219, 39, 119, 0.5)",
    iconBg: "rgba(219, 39, 119, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>`,
  },
  {
    name: "𝕏-tracker",
    url: "https://x-tracker.codingmarvel.com/",
    description: "Hit 100 posts and replies a day on X. Track the quota, the mix, and the streak.",
    accent: "#d97706",
    bg: "linear-gradient(135deg, rgba(217, 119, 6, 0.09) 0%, rgba(217, 119, 6, 0.02) 100%)",
    border: "rgba(217, 119, 6, 0.22)",
    hoverBorder: "rgba(217, 119, 6, 0.5)",
    iconBg: "rgba(217, 119, 6, 0.12)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Bungee&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:site_name" content="CodingMarvel" />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  </head>
  <body>
    <div class="bg-orbs" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="gaming-elements" aria-hidden="true">
      <span class="game-el game-el--1">▲</span>
      <span class="game-el game-el--2">◆</span>
      <span class="game-el game-el--3">●</span>
      <span class="game-el game-el--4">■</span>
      <span class="game-el game-el--5">✕</span>
      <span class="game-el game-el--6">★</span>
      <span class="game-el game-el--7">◆</span>
      <span class="game-el game-el--8">●</span>
    </div>
    <main class="page">
      <header class="header">
        <h1 class="brand">CODINGMARVEL.COM</h1>
        <p class="subtitle">
          New here? Welcome! Discover a great collection of web tools — pick any
          square below to jump in.
        </p>
      </header>

      <ul class="list">
        {websites.map((site) => (
          <li>
            <a
              class="card"
              href={site.url}
              target="_blank"
              rel="noreferrer"
              style={{
                "--card-accent": site.accent,
                "--card-bg": site.bg,
                "--card-border": site.border,
                "--card-hover-border": site.hoverBorder,
                "--card-icon-bg": site.iconBg,
              }}
            >
              <div class="card-header">
                <span class="card-icon" aria-hidden="true" set:html={site.iconSvg} />
                <div class="card-title">{site.name}</div>
              </div>
              <p class="card-desc">{site.description}</p>
              <span class="card-link">Visit {site.name}</span>
              <span class="card-arrow" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <footer class="footer">
        © {new Date().getFullYear()} codingmarvel.com · Built for quick discovery of useful web tools.
      </footer>
    </main>
  </body>
</html>
