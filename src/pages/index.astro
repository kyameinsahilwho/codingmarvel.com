---
import "../styles/global.css";
import { apps, type App } from "../data/apps";
import AppActions from "../components/AppActions.astro";

const byPlatform = (p: App["platform"]) => apps.filter((a) => a.platform === p);

const seo = {
  title: "CodingMarvel | Web Tools, Windows Apps, Extensions & Skills",
  description:
    "codingmarvel.com is a directory of tools by CodingMarvel: browser apps for tasks, habits, PDFs and video, native Windows utilities built in Rust, Chrome extensions and Claude Code agent skills.",
  canonical: "https://codingmarvel.com/",
  ogImage: "https://codingmarvel.com/og.svg",
  ogImageAlt: "CodingMarvel - Web Tools Directory",
  keywords: [
    "codingmarvel",
    "web tools",
    "online utilities",
    "rust windows apps",
    "tauri",
    ...apps.flatMap((a) => [a.plainName ?? a.name, ...a.keywords]),
  ].join(", "),
  author: "CodingMarvel",
  locale: "en_US",
  type: "website",
  themeColor: "#e53935",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "CodingMarvel",
      url: seo.canonical,
      description: seo.description,
      inLanguage: "en",
    },
    {
      "@type": "ItemList",
      name: "CodingMarvel apps",
      // Only apps people can actually reach (a site or a public repo).
      itemListElement: apps
        .filter((a) => primaryUrl(a))
        .map((a, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "SoftwareApplication",
            name: a.plainName ?? a.name,
            description: a.description,
            url: primaryUrl(a),
            applicationCategory: a.category,
            operatingSystem: osFor(a.platform),
            ...(sourceUrl(a) ? { codeRepository: sourceUrl(a) } : {}),
            offers: {
              "@type": "Offer",
              price: a.price?.amount ?? "0",
              priceCurrency: a.price?.currency ?? "USD",
            },
          },
        })),
    },
  ],
};

function sourceUrl(a: App) {
  return a.sourceUrl ?? (a.repo ? `https://github.com/${a.repo}` : null);
}

function primaryUrl(a: App) {
  return a.url ?? sourceUrl(a);
}

function osFor(p: App["platform"]) {
  return { Web: "Any (web browser)", Windows: "Windows 10, Windows 11", Chrome: "Google Chrome", Skill: "Claude Code" }[p];
}

const sections = [
  {
    id: "web",
    title: "Web apps",
    note: "Run in your browser. Nothing to install.",
    items: byPlatform("Web"),
  },
  {
    id: "windows",
    title: "Windows apps",
    note: "Native desktop tools, written in Rust.",
    items: byPlatform("Windows"),
  },
  {
    id: "extensions",
    title: "Chrome extensions",
    note: "Free. Install from GitHub with Load unpacked.",
    items: byPlatform("Chrome"),
  },
  {
    id: "skills",
    title: "Agent skills",
    note: "Claude Code skills I use and share.",
    items: byPlatform("Skill"),
  },
];

const icons = {
  chevron: '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Bungee&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:site_name" content="CodingMarvel" />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="gaming-elements" aria-hidden="true">
      <span class="game-el game-el--1">▲</span>
      <span class="game-el game-el--2">◆</span>
      <span class="game-el game-el--3">●</span>
      <span class="game-el game-el--4">■</span>
      <span class="game-el game-el--5">✕</span>
      <span class="game-el game-el--6">★</span>
      <span class="game-el game-el--7">◆</span>
      <span class="game-el game-el--8">●</span>
    </div>

    <main class="page">
      <header class="header">
        <h1 class="brand">CODINGMARVEL.COM</h1>
        <p class="subtitle">
          Tools I build and use every day. Pick an app to see what it does, then open it.
        </p>
        <nav class="header-meta" aria-label="Sections">
          {sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title}
              <span aria-hidden="true">{s.items.length}</span>
            </a>
          ))}
        </nav>
      </header>

      {sections.map((section) => (
        <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <div class="section-head">
            <h2 class="section-title" id={`${section.id}-title`}>
              {section.title}
              <span class="section-count" aria-hidden="true">{section.items.length}</span>
              <span class="sr-only">({section.items.length})</span>
            </h2>
            <p class="section-note">{section.note}</p>
          </div>

          <ul class="list">
            {section.items.map((app) => {
              const detailsId = `app-${app.slug}-details`;
              const href = primaryUrl(app);
              const label = app.plainName ?? app.name;
              return (
                <li class="app" style={`--accent: ${app.accent}`} data-app>
                  <div class="app-main">
                    <div class={`app-icon${app.iconFull ? " is-full" : ""}`} aria-hidden="true">
                      <img src={app.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
                    </div>
                    <div class="app-heading">
                      <h3 class="app-name">
                        {href ? (
                          <a href={href} target="_blank" rel="noopener">
                            <span aria-hidden={app.plainName ? "true" : undefined}>{app.name}</span>
                            {app.plainName && <span class="sr-only">{app.plainName}</span>}
                          </a>
                        ) : (
                          app.name
                        )}
                      </h3>
                      <p class="app-tagline">{app.tagline}</p>
                    </div>
                    <div class="app-side">
                      <AppActions app={app} label={label} variant="row" />
                      <button
                        class="app-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls={detailsId}
                        aria-label={`Show details for ${label}`}
                        data-label={label}
                        data-toggle
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.chevron} />
                      </button>
                      <span class="app-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron} />
                      </span>
                    </div>
                  </div>

                  <div class="app-details" id={detailsId}>
                    <div class="app-details-inner">
                      <div class="app-details-body">
                        <p class="app-desc">{app.description}</p>
                        <ul class="app-features" aria-label={`${label} features`}>
                          {app.features.map((f) => (
                            <li>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
                              <span>{f}</span>
                            </li>
                          ))}
                        </ul>
                        {app.price && <p class="app-note">{app.price.note}</p>}
                        {app.credit && <p class="app-note">{app.credit}</p>}
                        <div class="app-foot">
                          <ul class="app-stack" aria-label="Built with">
                            {app.stack.map((s) => <li>{s}</li>)}
                          </ul>
                          <AppActions app={app} label={label} variant="panel" />
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <footer class="footer">
        © {new Date().getFullYear()} codingmarvel.com · More projects on
        <a href="https://github.com/kyameinsahilwho" target="_blank" rel="noopener">GitHub</a>.
      </footer>
    </main>

    <script>
      // Tap / click the chevron to pin a card open (touch devices have no hover).
      document.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>("[data-app]");
          if (!card) return;
          const open = card.classList.toggle("is-open");
          btn.setAttribute("aria-expanded", String(open));
          btn.setAttribute("aria-label", `${open ? "Hide" : "Show"} details for ${btn.dataset.label ?? "app"}`);
        });
      });
    </script>
  </body>
</html>
