---
import "../styles/global.css";
import { apps, type App } from "../data/apps";

const webApps = apps.filter((a) => a.platform === "Web");
const windowsApps = apps.filter((a) => a.platform === "Windows");

const seo = {
  title: "CodingMarvel | Web Tools & Windows Apps",
  description:
    "codingmarvel.com is a directory of free tools by CodingMarvel: browser apps for tasks, habits, PDFs and video, plus open-source Windows utilities built in Rust.",
  canonical: "https://codingmarvel.com/",
  ogImage: "https://codingmarvel.com/og.svg",
  ogImageAlt: "CodingMarvel - Web Tools & Windows Apps",
  keywords: [
    "codingmarvel",
    "web tools",
    "online utilities",
    "rust windows apps",
    "tauri",
    ...apps.flatMap((a) => [a.name, ...a.keywords]),
  ].join(", "),
  author: "CodingMarvel",
  locale: "en_US",
  type: "website",
  themeColor: "#e53935",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "CodingMarvel",
      url: seo.canonical,
      description: seo.description,
      inLanguage: "en",
    },
    {
      "@type": "ItemList",
      name: "CodingMarvel apps",
      itemListElement: apps.map((a, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "SoftwareApplication",
          name: a.name,
          description: a.description,
          url: primaryUrl(a) ?? seo.canonical,
          applicationCategory: a.category,
          operatingSystem: a.platform === "Web" ? "Any (web browser)" : "Windows 10, Windows 11",
          ...(a.repo ? { codeRepository: `https://github.com/${a.repo}` } : {}),
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        },
      })),
    },
  ],
};

function primaryUrl(a: App) {
  return a.url ?? (a.repo ? `https://github.com/${a.repo}` : null);
}

const sections = [
  {
    id: "web",
    title: "Web apps",
    note: "Run in your browser. Nothing to install.",
    items: webApps,
  },
  {
    id: "windows",
    title: "Windows apps",
    note: "Native desktop tools in Rust. Open source.",
    items: windowsApps,
  },
];

const icons = {
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  external: '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={seo.author} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Bungee&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:site_name" content="CodingMarvel" />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="gaming-elements" aria-hidden="true">
      <span class="game-el game-el--1">▲</span>
      <span class="game-el game-el--2">◆</span>
      <span class="game-el game-el--3">●</span>
      <span class="game-el game-el--4">■</span>
      <span class="game-el game-el--5">✕</span>
      <span class="game-el game-el--6">★</span>
      <span class="game-el game-el--7">◆</span>
      <span class="game-el game-el--8">●</span>
    </div>

    <main class="page">
      <header class="header">
        <h1 class="brand">CODINGMARVEL.COM</h1>
        <p class="subtitle">
          Free tools I build and use every day. Pick an app to see what it does, then open it.
        </p>
        <nav class="header-meta" aria-label="Sections">
          {sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title}
              <span aria-hidden="true">{s.items.length}</span>
            </a>
          ))}
        </nav>
      </header>

      {sections.map((section) => (
        <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <div class="section-head">
            <h2 class="section-title" id={`${section.id}-title`}>
              {section.title}
              <span class="section-count">{section.items.length}</span>
            </h2>
            <p class="section-note">{section.note}</p>
          </div>

          <ul class="list">
            {section.items.map((app) => {
              const detailsId = `app-${app.slug}-details`;
              const repoUrl = app.repo ? `https://github.com/${app.repo}` : null;
              const href = primaryUrl(app);
              return (
                <li class="app" style={`--accent: ${app.accent}`} data-app>
                  <div class="app-main">
                    <div class={`app-icon${app.iconFull ? " is-full" : ""}`} aria-hidden="true">
                      <img src={app.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
                    </div>
                    <div class="app-heading">
                      <h3 class="app-name">
                        {href ? (
                          <a href={href} target="_blank" rel="noopener">
                            {app.name}
                          </a>
                        ) : (
                          app.name
                        )}
                      </h3>
                      <p class="app-tagline">{app.tagline}</p>
                    </div>
                    <div class="app-side">
                      <button
                        class="app-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls={detailsId}
                        aria-label={`Show details for ${app.name}`}
                        data-toggle
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.chevron} />
                      </button>
                    </div>
                  </div>

                  <div class="app-details" id={detailsId}>
                    <div class="app-details-inner">
                      <div class="app-details-body">
                        <p class="app-desc">{app.description}</p>
                        <ul class="app-features" aria-label={`${app.name} features`}>
                          {app.features.map((f) => (
                            <li>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
                              <span>{f}</span>
                            </li>
                          ))}
                        </ul>
                        <div class="app-foot">
                          <ul class="app-stack" aria-label="Built with">
                            {app.stack.map((s) => <li>{s}</li>)}
                          </ul>
                          <div class="app-actions">
                            {app.url && (
                              <a class="btn btn-primary" href={app.url} target="_blank" rel="noopener">
                                Open {app.name}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
                              </a>
                            )}
                            {repoUrl && (
                              <a
                                class={`btn ${app.url ? "btn-ghost" : "btn-primary"}`}
                                href={repoUrl}
                                target="_blank"
                                rel="noopener"
                              >
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.github} />
                                {app.url ? "Source" : "View on GitHub"}
                              </a>
                            )}
                            {!app.url && !repoUrl && <span class="btn-note">{app.status ?? "Coming soon"}</span>}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <footer class="footer">
        © {new Date().getFullYear()} codingmarvel.com · Source for every app is on
        <a href="https://github.com/kyameinsahilwho" target="_blank" rel="noopener">GitHub</a>.
      </footer>
    </main>

    <script>
      // Tap / click the chevron to pin a card open (touch devices have no hover).
      document.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>("[data-app]");
          if (!card) return;
          const open = card.classList.toggle("is-open");
          btn.setAttribute("aria-expanded", String(open));
          btn.setAttribute("aria-label", `${open ? "Hide" : "Show"} details for ${card.querySelector(".app-name")?.textContent?.trim() ?? "app"}`);
        });
      });
    </script>
  </body>
</html>
