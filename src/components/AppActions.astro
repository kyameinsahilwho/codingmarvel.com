---
import type { App } from "../data/apps";

interface Props {
  app: App;
  label: string;
  /** "row" = compact buttons in the card header (mouse), "panel" = inside the details (touch). */
  variant: "row" | "panel";
}

const { app, label, variant } = Astro.props;
const repoUrl = app.sourceUrl ?? (app.repo ? `https://github.com/${app.repo}` : null);
const compact = variant === "row";

const icons = {
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  external: '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
};
---

<div class={`app-actions app-actions--${variant}`}>
  {app.url && (
    <a class="btn btn-primary" href={app.url} target="_blank" rel="noopener" aria-label={`Open ${label}`}>
      {compact ? "Open" : `Open ${app.name}`}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
    </a>
  )}
  {repoUrl && (
    <a
      class={`btn ${app.url ? "btn-ghost" : "btn-primary"}${compact && app.url ? " btn-icon" : ""}`}
      href={repoUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Source code for ${label} on GitHub`}
      title={compact && app.url ? "Source on GitHub" : undefined}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.github} />
      {!(compact && app.url) && (app.url ? "Source" : "View on GitHub")}
    </a>
  )}
  {!app.url && !repoUrl && <span class="btn-note">{app.status ?? "Coming soon"}</span>}
</div>
