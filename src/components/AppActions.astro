---
import type { App } from "../data/apps";

interface Props {
  app: App;
  label: string;
}

const { app, label } = Astro.props;
const repoUrl = app.sourceUrl ?? (app.repo ? `https://github.com/${app.repo}` : null);
const hasPrimary = Boolean(app.url || app.download);

const icons = {
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  external: '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  download: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
};
---

<!--
  Enamel "key" buttons. data-key picks the shader material:
  "accent" = the app's own colour (--key, AA-safe), "graphite" = neutral.
-->
<div class="app-actions">
  {app.download && (
    <a class="btn btn-key btn-grow" data-key="accent" href={app.download} target="_blank" rel="noopener" aria-label={`Download ${label} for Windows`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.download} />
      Download
    </a>
  )}
  {app.url && (
    <a class="btn btn-key btn-grow" data-key="accent" href={app.url} target="_blank" rel="noopener" aria-label={`Open ${label}`}>
      Open app
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
    </a>
  )}
  {repoUrl && (
    <a
      class={`btn btn-key${hasPrimary ? "" : " btn-grow"}`}
      data-key={hasPrimary ? "graphite" : "accent"}
      href={repoUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Source code for ${label} on GitHub`}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.github} />
      {hasPrimary ? "Source" : "View on GitHub"}
    </a>
  )}
  {!hasPrimary && !repoUrl && <span class="btn-note">{app.status ?? "Coming soon"}</span>}
</div>
