---
/*
  Live "enamel key" material for the header.
  Glossy red lacquer whose surface drifts slowly (domain-warped noise as a
  height field), lit by a light that follows the pointer, with halftone dots
  printed into the shaded areas like arcade-cabinet art.

  - One full-screen triangle, no libraries.
  - Renders only while the header is on screen and the tab is visible.
  - prefers-reduced-motion: one still frame.
  - No WebGL: the canvas stays transparent and the header's CSS red shows.
  - Colour is clamped where the subtitle sits so white text keeps AA contrast.
*/
---

<canvas class="enamel" aria-hidden="true" data-enamel></canvas>

<script>
  const VERT = `
attribute vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

  const FRAG = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 uRes;      // canvas size in device px
uniform float uTime;    // seconds
uniform vec2 uLight;    // light position, 0..1 (y up)
uniform float uDpr;
uniform vec4 uText;     // body-text box in uv (x0, y0, x1, y1), y up

// --- simplex noise (Ashima / Stefan Gustavson, MIT) ---
vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }
float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m; m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

float fbm(vec2 p) {
  float s = 0.0, a = 0.5;
  for (int i = 0; i < 3; i++) { s += a * snoise(p); p = p * 1.97 + 17.1; a *= 0.42; }
  return s;
}

// warped height field: slow, liquid lacquer
float height(vec2 p, float t) {
  vec2 q = vec2(fbm(p + vec2(0.0, t * 0.045)), fbm(p + vec2(5.2, 1.3) - t * 0.035));
  return fbm(p + 0.75 * q + vec2(t * 0.015, 0.0));
}

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
  vec2 frag = gl_FragCoord.xy;
  vec2 uv = frag / uRes;
  float aspect = uRes.x / uRes.y;
  vec2 p = vec2(uv.x * aspect, uv.y) * 0.62;
  float t = uTime;

  // surface normal from finite differences of the height field
  float e = 0.01;
  float h  = height(p, t);
  float hx = height(p + vec2(e, 0.0), t);
  float hy = height(p + vec2(0.0, e), t);
  vec2 slope = vec2(hx - h, hy - h) / e;
  vec3 n = normalize(vec3(-slope * 0.11, 1.0));

  // light follows the pointer, hovering above the slab
  vec3 lp = vec3(uLight.x * aspect * 0.62, uLight.y * 0.62, 0.55);
  vec3 sp = vec3(p, 0.0);
  vec3 l = normalize(lp - sp);
  vec3 v = vec3(0.0, 0.0, 1.0);
  float diff = clamp(dot(n, l), 0.0, 1.0);
  float spec = pow(clamp(dot(reflect(-l, n), v), 0.0, 1.0), 22.0);

  // enamel palette (brand red #d32f2f with deep and lit tones)
  vec3 deep  = vec3(0.47, 0.06, 0.07);
  vec3 base  = vec3(0.83, 0.18, 0.18);
  vec3 lit   = vec3(0.93, 0.30, 0.26);
  vec3 col = mix(deep, base, smoothstep(0.3, 0.88, diff));
  col = mix(col, lit, smoothstep(0.93, 1.0, diff) * 0.55);

  // halftone print in the shadows: rotated dot screen, dot size from darkness
  float cell = 7.0 * uDpr;
  mat2 rot = mat2(0.7071, -0.7071, 0.7071, 0.7071);
  vec2 g = rot * frag / cell;
  vec2 f = fract(g) - 0.5;
  float shade = 1.0 - smoothstep(0.35, 0.7, diff);
  float r = 0.44 * sqrt(shade);
  float dotMask = 1.0 - smoothstep(r - 0.06, r + 0.06, length(f));
  col = mix(col, deep * 0.82, dotMask * 0.55);

  // lacquer highlight, tinted warm (never white)
  col += vec3(1.0, 0.55, 0.45) * spec * 0.32;

  // keep white text readable: subtitle zone (lower left) stays <= brand red,
  // everywhere else <= a level that still passes for the large wordmark
  vec2 soft = vec2(0.04, 0.08);
  float textZone = smoothstep(uText.x - soft.x, uText.x, uv.x) * (1.0 - smoothstep(uText.z, uText.z + soft.x, uv.x))
                 * smoothstep(uText.y - soft.y, uText.y, uv.y) * (1.0 - smoothstep(uText.w, uText.w + soft.y, uv.y));
  // relative luminance in linear light: white on L <= 0.175 is >= 4.7:1,
  // on L <= 0.28 it is >= 3.2:1 (enough for the large wordmark)
  float maxL = mix(0.28, 0.175, textZone);
  float L = luma(pow(max(col, 0.0), vec3(2.2)));
  col *= pow(min(1.0, maxL / max(L, 1e-4)), 1.0 / 2.2);

  // film grain
  float grain = fract(sin(dot(frag, vec2(12.9898, 78.233)) + t) * 43758.5453) - 0.5;
  col += grain * 0.018;

  gl_FragColor = vec4(col, 1.0);
}`;

  function initEnamel(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext("webgl", { antialias: false, alpha: true, premultipliedAlpha: false, powerPreference: "low-power" });
    if (!gl) return;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? "shader");
      return s;
    };
    let prog: WebGLProgram;
    try {
      prog = gl.createProgram()!;
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error("link");
    } catch {
      return; // CSS fallback stays visible
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "uRes");
    const uTime = gl.getUniformLocation(prog, "uTime");
    const uLight = gl.getUniformLocation(prog, "uLight");
    const uDpr = gl.getUniformLocation(prog, "uDpr");
    const uText = gl.getUniformLocation(prog, "uText");
    const header = canvas.parentElement!;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Render below native resolution: the material is soft, so this is free quality-wise.
    const scale = () => Math.min(window.devicePixelRatio || 1, 2) * 0.6;

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      const s = scale();
      const w = Math.max(1, Math.round(r.width * s));
      const h = Math.max(1, Math.round(r.height * s));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
      gl.uniform2f(uRes, w, h);
      gl.uniform1f(uDpr, s);
      // Box around the normal-size white text (subtitle + section links): the
      // shader keeps the enamel dark enough there for AA contrast.
      const boxes = [...header.querySelectorAll<HTMLElement>("[data-enamel-text]")].map((el) => el.getBoundingClientRect());
      if (boxes.length) {
        const pad = 10;
        const x0 = Math.min(...boxes.map((b) => b.left)) - pad - r.left;
        const x1 = Math.max(...boxes.map((b) => b.right)) + pad - r.left;
        const y0 = Math.min(...boxes.map((b) => b.top)) - pad - r.top;
        const y1 = Math.max(...boxes.map((b) => b.bottom)) + pad - r.top;
        gl.uniform4f(uText, x0 / r.width, 1 - y1 / r.height, x1 / r.width, 1 - y0 / r.height);
      } else {
        gl.uniform4f(uText, 0, 0, 1, 1);
      }
    };

    // Light: eases toward the pointer; drifts in a slow orbit when idle.
    const light = { x: 0.78, y: 0.82 };
    const target = { x: 0.78, y: 0.82 };
    let lastPointer = -1e9;
    window.addEventListener(
      "pointermove",
      (e) => {
        const r = canvas.getBoundingClientRect();
        target.x = Math.min(1.3, Math.max(-0.3, (e.clientX - r.left) / r.width));
        target.y = Math.min(1.6, Math.max(-0.6, 1 - (e.clientY - r.top) / r.height));
        lastPointer = performance.now();
      },
      { passive: true },
    );

    let visible = true;
    let raf = 0;
    const start = performance.now();
    const t0 = 40 + Math.random() * 60; // start mid-flow, not at a seam

    const frame = (now: number) => {
      raf = 0;
      const t = t0 + (now - start) / 1000;
      if (now - lastPointer > 2500) {
        target.x = 0.62 + 0.28 * Math.cos(t * 0.21);
        target.y = 0.78 + 0.18 * Math.sin(t * 0.17);
      }
      light.x += (target.x - light.x) * 0.06;
      light.y += (target.y - light.y) * 0.06;
      resize();
      gl.uniform1f(uTime, t);
      gl.uniform2f(uLight, light.x, light.y);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add("is-live");
      if (visible && !document.hidden && !reduce.matches) raf = requestAnimationFrame(frame);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) kick();
    }).observe(canvas);
    document.addEventListener("visibilitychange", () => !document.hidden && kick());
    reduce.addEventListener("change", kick);
    window.addEventListener("resize", kick, { passive: true });
    kick();
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-enamel]").forEach(initEnamel);
</script>
