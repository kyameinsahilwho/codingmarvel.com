---
/*
  Enamel "key" material for the app buttons (.btn[data-key]).
  A quiet cousin of the header lacquer: the button's own colour with a
  faint drifting sheen, a soft keycap roll-off at the edges, a whisper of
  halftone on the bottom lip, and a broad gloss that follows the pointer on
  hover, with a light glint as you arrive. Kept deliberately subtle.

  - ONE WebGL context for every button (browsers cap live contexts at ~16):
    it renders each visible button in turn into a hidden canvas and blits
    the result into that button's own 2D canvas.
  - Only buttons on screen are drawn (collapsed cards clip theirs away).
    Idle buttons tick at 24 fps; hovered or pressed ones run at full rate.
  - Colour is clamped so white label text keeps >= 4.7:1 contrast.
  - prefers-reduced-motion: still surface, no glint; hover still relights.
  - No WebGL / context lost: the flat CSS key colour shows through.
*/
---

<script>
  const VERT = `
attribute vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

  const FRAG = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 uRes;      // button size in device px
uniform float uTime;    // seconds
uniform vec2 uLight;    // light over the button, uv (y up); may sit outside 0..1
uniform vec3 uBase;     // key colour, sRGB 0..1 (already AA-safe)
uniform float uHover;   // 0..1
uniform float uPress;   // 0..1
uniform float uSweep;   // glint progress 0..1, < 0 = none
uniform float uDpr;
uniform float uSeed;
uniform float uRadius;  // corner radius, device px
uniform float uMaxL;    // luminance ceiling for white text

// --- simplex noise (Ashima / Stefan Gustavson, MIT) ---
vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }
float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m; m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

// slow, faint lacquer drift: one warp over two octaves
float height(vec2 p, float t) {
  vec2 q = vec2(snoise(p + vec2(0.0, t * 0.05)), snoise(p + vec2(5.2, 1.3) - t * 0.04));
  vec2 w = p + 0.45 * q;
  return snoise(w + vec2(t * 0.02, 0.0)) + 0.4 * snoise(w * 2.1 + 9.7);
}

float sdRoundBox(vec2 p, vec2 b, float r) {
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

void main() {
  vec2 frag = gl_FragCoord.xy;
  vec2 uv = frag / uRes;
  float aspect = uRes.x / uRes.y;
  float t = uTime;

  // lacquer: noise height field, sized in CSS px so every key matches
  vec2 p = frag / (uDpr * 120.0) + uSeed;
  float e = 0.03;
  float h  = height(p, t);
  vec2 slope = vec2(height(p + vec2(e, 0.0), t) - h, height(p + vec2(0.0, e), t) - h) / e;

  // keycap pillow: the surface rolls off over the last few px of every edge
  vec2 c = frag - uRes * 0.5;
  vec2 half_ = uRes * 0.5;
  float d = sdRoundBox(c, half_, uRadius);
  vec2 k = vec2(1.0, 0.0);
  vec2 out_ = normalize(vec2(
    sdRoundBox(c + k.xy, half_, uRadius) - sdRoundBox(c - k.xy, half_, uRadius),
    sdRoundBox(c + k.yx, half_, uRadius) - sdRoundBox(c - k.yx, half_, uRadius)) + 1e-5);
  float bev = smoothstep(-6.0 * uDpr, 0.0, d);
  bev *= bev;

  float flat_ = 1.0 - 0.55 * uPress;  // pressing flattens the gloss
  vec3 n = normalize(vec3(-slope * 0.008 * flat_ + out_ * bev * 1.0, 1.0));

  // light: up-left and high when idle; leans in toward the pointer on hover
  vec3 sp = vec3(uv.x * aspect, uv.y, 0.0);
  vec3 lp = vec3(uLight.x * aspect, uLight.y, mix(1.2, 0.85, uHover));
  vec3 l = normalize(lp - sp);
  float diff = clamp(dot(n, l), 0.0, 1.0);
  float spec = pow(clamp(dot(reflect(-l, n), vec3(0.0, 0.0, 1.0)), 0.0, 1.0), 9.0);

  vec3 deep = uBase * 0.78;
  vec3 lit  = mix(uBase, vec3(1.0, 0.93, 0.88), 0.18);
  vec3 col = mix(deep, uBase, smoothstep(0.6, 0.97, diff));
  col = mix(col, lit, smoothstep(0.985, 1.0, diff) * 0.25);
  // keycaps are lit from above: a soft top-to-bottom fall-off
  col *= mix(0.94, 1.04, smoothstep(0.0, 1.0, uv.y));

  // halftone print, only where the lip turns away from the light
  float cell = 3.5 * uDpr;
  mat2 rot = mat2(0.7071, -0.7071, 0.7071, 0.7071);
  vec2 f = fract(rot * frag / cell) - 0.5;
  float shade = (1.0 - smoothstep(0.75, 0.97, diff)) * (1.0 - smoothstep(0.25, 0.6, uv.y));
  float r = 0.44 * sqrt(shade);
  float aa = 0.9 / cell;
  float dotMask = 1.0 - smoothstep(r - aa, r + aa, length(f));
  col = mix(col, deep * 0.85, dotMask * 0.1);

  // broad gloss, warmer and stronger when the light leans in
  col += vec3(1.0, 0.9, 0.84) * spec * (0.05 + 0.13 * uHover);

  // glint sweeping across on arrival
  if (uSweep >= 0.0) {
    float x = uv.x + (uv.y - 0.5) * 0.45 / aspect;
    float gx = (x - mix(-0.3, 1.3, uSweep)) / 0.09; // squared by hand: pow() of a negative base is undefined
    float g = exp(-gx * gx);
    col += vec3(1.0, 0.94, 0.9) * g * 0.08 * (1.0 - uSweep);
  }

  // lit top lip, darker bottom lip, deeper when pressed
  col += uBase * 0.18 * bev * max(out_.y, 0.0);
  col *= 1.0 - 0.15 * bev * max(-out_.y, 0.0);
  col *= 1.0 - 0.06 * uPress;

  // keep white text readable everywhere on the key
  float L = luma(pow(max(col, 0.0), vec3(2.2)));
  // soft knee instead of a hard ceiling, so the gloss never shows a flat plateau
  float knee = uMaxL * 0.8;
  float Lc = L < knee ? L : knee + (uMaxL - knee) * (1.0 - exp(-(L - knee) / (uMaxL - knee)));
  col *= pow(Lc / max(L, 1e-4), 1.0 / 2.2);

  // film grain
  float grain = fract(sin(dot(frag, vec2(12.9898, 78.233)) + t) * 43758.5453) - 0.5;
  col += grain * 0.008;

  gl_FragColor = vec4(col, 1.0);
}`;

  type Key = {
    el: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    base: [number, number, number];
    seed: number;
    radius: number;
    w: number;
    h: number;
    s: number;
    visible: boolean;
    hovered: boolean;
    focused: boolean;
    hover: number;
    press: number;
    pressTo: number;
    sweep: number;
    light: { x: number; y: number };
    target: { x: number; y: number };
    dirty: boolean;
  };

  const REST = { x: 0.22, y: 1.35 };
  const MAX_L = 0.17;

  function parseColor(value: string): [number, number, number] | null {
    const m = /^#?([0-9a-f]{6})$/i.exec(value.trim());
    if (!m) return null;
    const n = parseInt(m[1], 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  }

  function initKeys() {
    const els = [...document.querySelectorAll<HTMLElement>(".btn[data-key]")];
    if (!els.length) return;

    const glCanvas = document.createElement("canvas");
    const gl = glCanvas.getContext("webgl", {
      antialias: false,
      alpha: false,
      depth: false,
      stencil: false,
      preserveDrawingBuffer: false,
      powerPreference: "low-power",
    });
    if (!gl) return;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? "shader");
      return s;
    };
    let prog: WebGLProgram;
    try {
      prog = gl.createProgram()!;
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error("link");
    } catch {
      return; // flat CSS keys stay
    }
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const u = Object.fromEntries(
      ["uRes", "uTime", "uLight", "uBase", "uHover", "uPress", "uSweep", "uDpr", "uSeed", "uRadius", "uMaxL"].map((n) => [
        n,
        gl.getUniformLocation(prog, n),
      ]),
    ) as Record<string, WebGLUniformLocation | null>;
    gl.uniform1f(u.uMaxL, MAX_L);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const dark = window.matchMedia("(prefers-color-scheme: dark)");
    let lost = false;

    const keys: Key[] = [];
    const byEl = new Map<Element, Key>();

    const readStyle = (k: Key) => {
      const cs = getComputedStyle(k.el);
      k.base = parseColor(cs.getPropertyValue("--key")) ?? [0.6, 0.12, 0.12];
      k.radius = parseFloat(cs.borderTopLeftRadius) || 10;
      k.dirty = true;
    };

    const sizeKey = (k: Key) => {
      const r = k.el.getBoundingClientRect();
      const s = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.round(r.width * s));
      const h = Math.max(1, Math.round(r.height * s));
      k.s = s;
      if (k.canvas.width !== w || k.canvas.height !== h) {
        k.canvas.width = w;
        k.canvas.height = h;
      }
      k.w = w;
      k.h = h;
      k.dirty = true;
    };

    const draw = (k: Key, t: number) => {
      if (glCanvas.width < k.w || glCanvas.height < k.h) {
        glCanvas.width = Math.max(glCanvas.width, k.w);
        glCanvas.height = Math.max(glCanvas.height, k.h);
      }
      gl.viewport(0, 0, k.w, k.h);
      gl.uniform2f(u.uRes, k.w, k.h);
      gl.uniform1f(u.uTime, t);
      gl.uniform2f(u.uLight, k.light.x, k.light.y);
      gl.uniform3f(u.uBase, k.base[0], k.base[1], k.base[2]);
      gl.uniform1f(u.uHover, k.hover);
      gl.uniform1f(u.uPress, k.press);
      gl.uniform1f(u.uSweep, k.sweep);
      gl.uniform1f(u.uDpr, k.s);
      gl.uniform1f(u.uSeed, k.seed);
      gl.uniform1f(u.uRadius, k.radius * k.s);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      // GL's origin is bottom-left: the frame sits at the bottom of the shared canvas.
      k.ctx.drawImage(glCanvas, 0, glCanvas.height - k.h, k.w, k.h, 0, 0, k.w, k.h);
      if (!k.el.classList.contains("is-live")) k.el.classList.add("is-live");
      k.dirty = false;
    };

    let raf = 0;
    let last = performance.now();
    let lastIdle = 0;
    const start = last;
    const t0 = 30 + (Date.now() % 50000) / 1000; // start mid-flow, not at a seam

    const busy = (k: Key) =>
      k.sweep >= 0 ||
      Math.abs((k.hovered || k.focused ? 1 : 0) - k.hover) > 0.002 ||
      Math.abs(k.pressTo - k.press) > 0.002 ||
      Math.abs(k.target.x - k.light.x) + Math.abs(k.target.y - k.light.y) > 0.002;

    const frame = (now: number) => {
      raf = 0;
      if (lost) return;
      const still = reduce.matches;
      const dt = Math.min(64, now - last);
      last = now;
      const t = still ? t0 : t0 + (now - start) / 1000;
      const idleTick = !still && now - lastIdle >= 1000 / 24;
      if (idleTick) lastIdle = now;
      let anyVisible = false;
      let anyBusy = false;

      for (const k of keys) {
        if (!k.visible) continue;
        anyVisible = true;
        const moving = busy(k);
        if (moving) {
          const a = still ? 1 : 1 - Math.pow(1 - 0.2, dt / 16.7);
          const ap = still ? 1 : 1 - Math.pow(1 - 0.4, dt / 16.7);
          k.hover += ((k.hovered || k.focused ? 1 : 0) - k.hover) * a;
          k.press += (k.pressTo - k.press) * ap;
          k.light.x += (k.target.x - k.light.x) * a;
          k.light.y += (k.target.y - k.light.y) * a;
          if (k.sweep >= 0) {
            k.sweep += dt / 700;
            if (k.sweep > 1 || still) k.sweep = -1;
          }
          anyBusy = true;
        }
        if (moving || k.dirty || idleTick || k.hover > 0.01) draw(k, t);
      }

      if (anyVisible && !document.hidden && (!still || anyBusy)) raf = requestAnimationFrame(frame);
    };

    const kick = () => {
      if (!raf && !lost) raf = requestAnimationFrame(frame);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const k = byEl.get(e.target);
          if (!k) continue;
          k.visible = e.isIntersecting && e.intersectionRect.height > 0;
          if (k.visible) k.dirty = true;
        }
        kick();
      },
      { rootMargin: "40px 0px" },
    );

    const ro = new ResizeObserver((entries) => {
      for (const e of entries) {
        const k = byEl.get(e.target);
        if (k) sizeKey(k);
      }
      kick();
    });

    els.forEach((el, i) => {
      const canvas = document.createElement("canvas");
      canvas.className = "key-gl";
      canvas.setAttribute("aria-hidden", "true");
      el.prepend(canvas);
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      const k: Key = {
        el,
        canvas,
        ctx,
        base: [0.6, 0.12, 0.12],
        seed: i * 7.31,
        radius: 10,
        w: 0,
        h: 0,
        s: 1,
        visible: false,
        hovered: false,
        focused: false,
        hover: 0,
        press: 0,
        pressTo: 0,
        sweep: -1,
        light: { ...REST },
        target: { ...REST },
        dirty: true,
      };
      readStyle(k);
      keys.push(k);
      byEl.set(el, k);

      const aim = (e: PointerEvent) => {
        const r = el.getBoundingClientRect();
        k.target.x = (e.clientX - r.left) / r.width;
        k.target.y = 1 - (e.clientY - r.top) / r.height + 0.15;
      };
      el.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "touch") return;
        k.hovered = true;
        aim(e);
        if (!reduce.matches) k.sweep = 0;
        kick();
      });
      el.addEventListener("pointermove", (e) => {
        if (e.pointerType === "touch") return;
        aim(e);
        kick();
      });
      el.addEventListener("pointerleave", () => {
        k.hovered = false;
        k.pressTo = 0;
        if (!k.focused) k.target = { ...REST };
        kick();
      });
      el.addEventListener("pointerdown", (e) => {
        k.pressTo = 1;
        if (e.pointerType === "touch") {
          aim(e);
          if (!reduce.matches) k.sweep = 0;
        }
        kick();
      });
      const release = () => {
        k.pressTo = 0;
        if (!k.hovered && !k.focused) k.target = { ...REST };
        kick();
      };
      el.addEventListener("pointerup", release);
      el.addEventListener("pointercancel", release);
      el.addEventListener("focus", () => {
        if (!el.matches(":focus-visible")) return;
        k.focused = true;
        k.target = { x: 0.5, y: 1.05 };
        if (!reduce.matches) k.sweep = 0;
        kick();
      });
      el.addEventListener("blur", () => {
        k.focused = false;
        if (!k.hovered) k.target = { ...REST };
        kick();
      });

      sizeKey(k);
      // device-pixel-content-box also fires when only the DPR changes
      // (zoom, another monitor); Safari lacks it, the matchMedia watch covers it.
      try {
        ro.observe(el, { box: "device-pixel-content-box" });
      } catch {
        ro.observe(el);
      }
      io.observe(el);
    });

    // Zoom or a move to another monitor changes the DPR without a CSS resize,
    // so ResizeObserver stays quiet: re-rasterise every key on DPR changes.
    const watchDpr = () => {
      const mq = window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
      mq.addEventListener(
        "change",
        () => {
          keys.forEach(sizeKey);
          kick();
          watchDpr();
        },
        { once: true },
      );
    };
    watchDpr();

    const restyle = () => {
      keys.forEach(readStyle);
      kick();
    };
    dark.addEventListener("change", restyle);
    reduce.addEventListener("change", kick);
    document.addEventListener("visibilitychange", () => !document.hidden && kick());

    glCanvas.addEventListener("webglcontextlost", (e) => {
      e.preventDefault();
      lost = true;
      keys.forEach((k) => k.el.classList.remove("is-live"));
    });

    kick();
  }

  if ("requestIdleCallback" in window) requestIdleCallback(initKeys, { timeout: 800 });
  else setTimeout(initKeys, 80);
</script>
